{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on monday"],
  "timezone": "America/Sao_Paulo",
  "rangeStrategy": "pin",
  "packageRules": [
    { "groupName": "next e react", "matchPackageNames": ["next", "react", "react-dom", "@types/react", "@types/react-dom", "@next/env"] },
    { "groupName": "supabase", "matchPackageNames": ["supabase", "/^@supabase\//"] },
    { "groupName": "testes", "matchPackageNames": ["vitest", "@vitest/coverage-v8", "jsdom", "/^@testing-library\//", "@playwright/test"] },
    { "groupName": "biome", "matchPackageNames": ["@biomejs/biome"] },
    { "matchPackageNames": ["typescript"], "enabled": false }
  ]
}
