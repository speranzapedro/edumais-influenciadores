# Copie para .env.local (na raiz do monorepo) e preencha. Nunca versione o .env.local.
# Local: `pnpm db:iniciar` mostra a URL e as chaves do Supabase local.

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...): pode ir para o navegador
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): só no servidor, nunca no navegador
SUPABASE_SECRET_KEY=
# Prefixo dos cookies de sessão (trocar invalida as sessões abertas)
SESSAO_COOKIE_PREFIXO=edu

# ── Endereços dos apps ──
NEXT_PUBLIC_PAINEL_URL=http://localhost:3006
NEXT_PUBLIC_APP_URL=http://localhost:3007

# ── Cadastro de criadores ──
# Chave do link secreto /cadastro/<chave> (16+ caracteres). Trocar invalida os links enviados. Gere com
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
CRIADOR_CADASTRO_CHAVE=

# ── IA (Anthropic) ──
ANTHROPIC_API_KEY=
# Modelos (opcionais; os padrões estão em packages/ai/src/modelo.ts)
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MODEL_PLANEJAMENTO=claude-sonnet-5-5
ANTHROPIC_MODEL_REVISOR=claude-sonnet-5-5
ANTHROPIC_MODEL_FEEDBACK=claude-haiku-5-5
ANTHROPIC_MODEL_TUTOR=claude-haiku-5-5
# Modo econômico do estúdio: sem revisor pedagógico, esforço baixo, 1 correção (true/false)
MODO_ECONOMICO=true
# Revisor pedagógico mesmo no modo econômico (true/false)
REVISOR_PEDAGOGICO=true

# ── Edu (tutor por trilha) ──
# Embeddings e reordenação (dashboard.voyageai.com). Só servidor.
VOYAGE_API_KEY=
TUTOR_HABILITADO=false

# ── Limites ──
# Execuções do agente do estúdio por criador por mês (padrão 60)
LIMITE_AGENTE_MES=60
# Perguntas ao Edu por fã por dia (padrão 30)
LIMITE_EDU_DIA=30
# Correções de perguntas abertas por fã por dia (padrão 80)
LIMITE_ABERTAS_DIA=80
APP_TIMEZONE=America/Sao_Paulo
