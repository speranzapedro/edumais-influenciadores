{
  "name": "edumais-influenciadores",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --project unit --project dom",
    "test:cobertura": "vitest run --project unit --project dom --coverage",
    "lint": "biome check .",
    "lint:corrigir": "biome check --write .",
    "verificar": "biome ci . && turbo run typecheck && vitest run --project unit --project dom --coverage",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "31.0.1",
    "lefthook": "2.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "turbo": "2.11.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
